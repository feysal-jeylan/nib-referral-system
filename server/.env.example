# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — it is listed in .gitignore.

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=referral_db

# JWT secret — used to sign and verify authentication tokens.
# In production: generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-here

# Prisma / PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# API key expected from the Mock Temenos (Core Banking) system in the x-api-key header.
# Must match the key configured in the Mock Temenos app.
MOCK_TEMENOS_API_KEY=your-api-key-here
