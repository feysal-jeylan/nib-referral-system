// referral-api/prisma/schema.prisma
//
// Prisma schema for the Nib Bank Referral System.
// Maps to the existing PostgreSQL database (referral_db).
//
// Rules:
//  - @@map / @map used throughout to match exact snake_case column & table names.
//  - No prisma migrate — DB was created via raw SQL scripts; we use db pull to verify.
//  - "commonjs" project — client consumed with require('../db-prisma').

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── users ───────────────────────────────────────────────────────────────────
model User {
  id                   Int      @id @default(autoincrement())
  username             String   @unique @db.VarChar(50)
  password_hash        String   @db.VarChar(100)
  role                 String   @db.VarChar(10)
  agent_id             Int?
  created_at           DateTime @default(now()) @db.Timestamp(6)
  must_change_password Boolean  @default(true)

  agent Agent? @relation(fields: [agent_id], references: [id], onDelete: SetNull)

  @@map("users")
}

// ─── agents ──────────────────────────────────────────────────────────────────
model Agent {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  phone         String   @unique @db.VarChar(20)
  email         String   @unique @db.VarChar(100)
  referral_code String?  @unique @db.VarChar(20)
  status        String   @default("PENDING") @db.VarChar(20)
  created_at    DateTime @default(now()) @db.Timestamp(6)

  referrals Referral[]
  users     User[]

  @@map("agents")
}

// ─── referrals ───────────────────────────────────────────────────────────────
model Referral {
  id             Int      @id @default(autoincrement())
  agent_id       Int
  customer_name  String?  @db.VarChar(100)
  customer_phone String?  @db.VarChar(20)
  campaign_id    Int?
  status         String   @default("PENDING") @db.VarChar(20)
  created_at     DateTime @default(now()) @db.Timestamp(6)

  agent    Agent     @relation(fields: [agent_id], references: [id], onDelete: Restrict)
  campaign Campaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)

  @@map("referrals")
}

// ─── campaigns ───────────────────────────────────────────────────────────────
model Campaign {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(100)
  campaign_code    String?  @unique @db.VarChar(50)
  start_date       DateTime @db.Timestamp(6)
  end_date         DateTime @db.Timestamp(6)
  reward_type      String   @db.VarChar(50)
  reward_value     String   @db.VarChar(100)
  status           String   @default("DRAFT") @db.VarChar(20)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  description      String?
  reward_threshold Int?
  is_active        Boolean  @default(true)
  parent_id        Int?

  parent   Campaign?  @relation("CampaignHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children Campaign[] @relation("CampaignHierarchy")

  rules     CampaignRule[]
  referrals Referral[]

  @@map("campaigns")
}

// ─── campaign_rules ──────────────────────────────────────────────────────────
// DB-level CHECK constraint: campaign_rules_operator_check
//   operator IN ('GREATER_THAN','LESS_THAN','EQUALS','GREATER_THAN_OR_EQUAL',
//                'LESS_THAN_OR_EQUAL','NOT_EQUALS','N/A')
// 'N/A' is the sentinel stored for COMPOSITE rules (operator is not applicable).
model CampaignRule {
  id          Int    @id @default(autoincrement())
  campaign_id Int
  rule_type   String @db.VarChar(50) // 'MIN_DEPOSIT' | 'ACCOUNT_TYPE' | 'COMPOSITE'
  rule_value  Json   @db.JsonB
  operator    String @default("EQUALS") @db.VarChar(30) // 'N/A' for COMPOSITE rules

  campaign Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@map("campaign_rules")
}

// ─── integration_logs ────────────────────────────────────────────────────────
model IntegrationLog {
  id             Int      @id @default(autoincrement())
  transaction_id String   @unique @db.VarChar(100)
  payload        Json     @db.JsonB
  status         String   @default("RECEIVED") @db.VarChar(20)
  error_message  String?
  created_at     DateTime @default(now()) @db.Timestamp(6)

  @@map("integration_logs")
}

